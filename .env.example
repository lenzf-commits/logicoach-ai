# Supabase Projekt-URL, z. B. https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Oeffentlicher Supabase anon key aus Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase Service Role Key nur fuer serverseitige Admin-Jobs verwenden.
# Niemals im Browser oder in Client Components nutzen.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API Key fuer das textbasierte Interview in Phase 6.
OPENAI_API_KEY=

# Optional: Modell fuer das textbasierte Interview ueberschreiben.
OPENAI_MODEL=gpt-5-mini
